# Пример настроек. Настоящие значения вставляются в Vercel (Settings → Environment Variables)
# или в файл .env.local при запуске на компьютере. Сам .env.local в GitHub не попадает.

# Адрес проекта Supabase: Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Публичный ключ Supabase: Project Settings → API Keys → Publishable key
# (если у проекта старые ключи — подойдёт "anon public")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Секретный ключ Supabase (Project Settings → API Keys → Secret key, или старый service_role).
# Используется ТОЛЬКО на сервере для ежедневной проверки ссылок. Никогда не добавляйте приставку NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Пароль для запуска проверки ссылок по расписанию (любая длинная случайная строка).
# Тот же самый вставляется в GitHub → Settings → Secrets → Actions → CRON_SECRET.
CRON_SECRET=

# Ключ шифрования паролей от почты (любая длинная случайная строка, 32+ символа). Только сервер, без NEXT_PUBLIC_.
MAIL_SECRET_KEY=
